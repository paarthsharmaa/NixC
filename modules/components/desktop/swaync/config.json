{
  "positionX": "right",
  "positionY": "top",

  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,

  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,

  "notification-grouping": true,
  "notification-inline-replies": true,
  "notification-2fa-action": true,

  "image-visibility": "when-available",

  "notification-window-width": 420,
  "control-center-width": 430,
  "control-center-height": 650,

  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },

    "dnd": {
      "text": "Do Not Disturb"
    }
  }
}
