pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

// Shell settings, two layers:
//   1. defaults.json  -- generated by Nix (quickshell/default.nix), read-only
//                        in the store, so it's the declarative baseline.
//   2. ~/.local/state/nixc/shell.json -- runtime overrides written by the
//                        shell itself (IPC now, a settings window later).
// A key in the user file wins; anything missing falls back to the default.
//
// Change one from a terminal:  qs ipc call settings set bar.style pill
// Reset it to the Nix default: qs ipc call settings reset bar.style
Singleton {
    id: root

    property var defaults: ({})
    property var user: ({})

    readonly property string stateDir: Quickshell.env("HOME") + "/.local/state/nixc"

    // ── Settings used by the shell ───────────────────────────────────────
    // "notch" (attached to the top edge) or "pill" (floating).
    readonly property string barStyle:   get("bar.style", "notch")
    // "theme" = matugen background, "black" = blends with screen corners.
    readonly property string notchColor: get("bar.notchColor", "theme")
    // Minimum workspace slots shown (more appear when used).
    readonly property int    workspaces: get("bar.workspaces", 5)
    // Shape animation length in ms.
    readonly property int    motion:     get("motion.duration", 260)

    // ── Lookup / write ───────────────────────────────────────────────────
    function lookup(obj: var, key: string): var {
        let v = obj
        for (const part of key.split(".")) {
            if (v === null || typeof v !== "object" || !(part in v)) return undefined
            v = v[part]
        }
        return v
    }

    function get(key: string, fallback: var): var {
        const u = lookup(root.user, key)
        if (u !== undefined) return u
        const d = lookup(root.defaults, key)
        return d !== undefined ? d : fallback
    }

    function write(next: var): void {
        root.user = next
        Quickshell.execDetached(["mkdir", "-p", root.stateDir])
        userFile.setText(JSON.stringify(next, null, 2) + "\n")
    }

    function set(key: string, value: var): void {
        const next = JSON.parse(JSON.stringify(root.user))
        const parts = key.split(".")
        let o = next
        for (const p of parts.slice(0, -1)) {
            if (typeof o[p] !== "object" || o[p] === null) o[p] = {}
            o = o[p]
        }
        o[parts[parts.length - 1]] = value
        write(next)
    }

    function reset(key: string): void {
        const next = JSON.parse(JSON.stringify(root.user))
        const parts = key.split(".")
        let o = next
        for (const p of parts.slice(0, -1)) {
            if (typeof o[p] !== "object" || o[p] === null) return
            o = o[p]
        }
        delete o[parts[parts.length - 1]]
        write(next)
    }

    function parse(text: string): var {
        try { return JSON.parse(text) } catch (e) { return {} }
    }

    FileView {
        path: Quickshell.shellPath("defaults.json")
        printErrors: false
        onLoaded: root.defaults = root.parse(text())
    }

    FileView {
        id: userFile
        path: root.stateDir + "/shell.json"
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        onLoaded: root.user = root.parse(text())
        onLoadFailed: root.user = {}
    }

    IpcHandler {
        target: "settings"

        // Values are parsed as JSON when possible ("5", "true"), else kept
        // as plain strings ("pill").
        function set(key: string, value: string): void {
            let v = value
            try { v = JSON.parse(value) } catch (e) {}
            root.set(key, v)
        }
        function reset(key: string): void { root.reset(key) }
        function get(key: string): string { return JSON.stringify(root.get(key, null)) }
    }
}
