# Kvantum theme generated by iris
[%General]
author=iris
comment=Material You theme generated from wallpaper
left_tabs=true
mirror_doc_tabs=true
composite=true
menu_shadow_depth=7
tooltip_shadow_depth=0
splitter_width=7
check_size=16
slider_width=4
slider_handle_width=18
slider_handle_length=18
menubar_mouse_tracking=true
slim_toolbars=false
translucent_windows=false
blurring=false
popup_blurring=true
fill_rubberband=false
spread_progressbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
scroll_arrows=false
combo_as_lineedit=true
button_contents_shift=false

[GeneralColors]
window.color={bg}
base.color={surface}
alt.base.color={bg}
button.color={surface}
light.color={surface}
mid.light.color={surface}
dark.color={bg}
mid.color={surface}
highlight.color={accent}
inactive.highlight.color={surface}
tooltip.base.color={surface}
text.color={fg}
window.text.color={fg}
button.text.color={fg}
disabled.text.color={dim}
tooltip.text.color={fg}
highlight.text.color={bg}
link.color={accent}
link.visited.color={accent}
contrast=1.00
opacity=100

[Hacks]
transparent_dolphin_view=false
blur_translucent=true
native_scrollbars=false
